# Workstation artifacts are disposable and never default to a source checkout.
ifneq ($(wildcard /run/media/user/data/.),)
AIRLOCK_DATA_ROOT ?= /run/media/user/data/airlock
endif
ifeq ($(strip $(AIRLOCK_DATA_ROOT)),)
$(error Set AIRLOCK_DATA_ROOT to an absolute disposable development directory)
endif
ifeq ($(filter /%,$(AIRLOCK_DATA_ROOT)),)
$(error AIRLOCK_DATA_ROOT must be absolute)
endif

AIRLOCK_VM_DIR ?= $(AIRLOCK_DATA_ROOT)/vm
AIRLOCK_LOG_DIR ?= $(AIRLOCK_DATA_ROOT)/logs
AIRLOCK_QUBES_CACHE_DIR ?= $(AIRLOCK_DATA_ROOT)/cache/rpms
AIRLOCK_RESULT_LINK_DIR ?= $(AIRLOCK_DATA_ROOT)/result-links
AIRLOCK_NIX_ROOT ?= $(AIRLOCK_DATA_ROOT)/nix-root
AIRLOCK_NIX_STORE ?= $(AIRLOCK_NIX_ROOT)
AIRLOCK_TMPDIR ?= $(AIRLOCK_DATA_ROOT)/tmp
AIRLOCK_PREPARED_CACHE ?= $(AIRLOCK_DATA_ROOT)/cache/prepared
AIRLOCK_CARGO_VENDOR ?= $(AIRLOCK_DATA_ROOT)/cache/authoring-vendor
AIRLOCK_PACKER_CARGO_VENDOR ?= $(AIRLOCK_DATA_ROOT)/cache/packer-vendor
AIRLOCK_CRATE2NIX ?= $(AIRLOCK_DATA_ROOT)/tools/crate2nix/bin/crate2nix
CARGO_TARGET_DIR ?= $(AIRLOCK_DATA_ROOT)/build/cargo
TMPDIR ?= $(AIRLOCK_TMPDIR)
XDG_CACHE_HOME ?= $(AIRLOCK_DATA_ROOT)/cache/xdg

$(foreach directory,AIRLOCK_VM_DIR AIRLOCK_LOG_DIR AIRLOCK_QUBES_CACHE_DIR AIRLOCK_RESULT_LINK_DIR AIRLOCK_NIX_ROOT AIRLOCK_NIX_STORE AIRLOCK_TMPDIR AIRLOCK_PREPARED_CACHE AIRLOCK_CARGO_VENDOR AIRLOCK_PACKER_CARGO_VENDOR AIRLOCK_CRATE2NIX CARGO_TARGET_DIR TMPDIR XDG_CACHE_HOME,$(if $(filter /%,$($(directory))),,$(error $(directory) must be absolute)))

export AIRLOCK_DATA_ROOT AIRLOCK_VM_DIR AIRLOCK_LOG_DIR AIRLOCK_QUBES_CACHE_DIR
export AIRLOCK_RESULT_LINK_DIR AIRLOCK_NIX_ROOT AIRLOCK_NIX_STORE AIRLOCK_TMPDIR
export AIRLOCK_PREPARED_CACHE AIRLOCK_CARGO_VENDOR CARGO_TARGET_DIR TMPDIR XDG_CACHE_HOME
export AIRLOCK_PACKER_CARGO_VENDOR AIRLOCK_CRATE2NIX
